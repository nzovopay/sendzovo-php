{
  "name": "sendzovo/sendzovo-php",
  "description": "Official PHP SDK for the Sendzovo transactional email and email verification APIs.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://sendzovo.com",
  "keywords": ["sendzovo", "email", "email-api", "transactional-email", "email-verification", "smtp", "sdk"],
  "support": {
    "docs": "https://docs.sendzovo.com",
    "source": "https://github.com/nzovopay/sendzovo-php",
    "issues": "https://github.com/nzovopay/sendzovo-php/issues"
  },
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {"Sendzovo\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"Sendzovo\\Tests\\": "tests/"}
  },
  "scripts": {"test": "phpunit"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
